{
  "name": "paper-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/renderer",
    "packages/shared-schema"
  ],
  "scripts": {
    "setup": "node scripts/tasks.mjs setup",
    "dev": "node scripts/tasks.mjs dev",
    "build": "npm run build --workspace apps/web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages tests && node scripts/tasks.mjs lint",
    "test": "vitest run && node scripts/tasks.mjs test",
    "demo-render": "node scripts/tasks.mjs demo",
    "migrate": "node scripts/tasks.mjs migrate",
    "e2e": "playwright test",
    "cleanup": "node scripts/tasks.mjs cleanup",
    "desktop": "npm run build && electron apps/desktop",
    "desktop:prepare": "node scripts/prepare_desktop.mjs",
    "desktop:pack": "npm run desktop:prepare && electron-builder --config apps/desktop/electron-builder.cjs --win --x64 --dir",
    "desktop:dist": "npm run desktop:prepare && electron-builder --config apps/desktop/electron-builder.cjs --win --x64",
    "desktop:test": "node --test tests/desktop/settings.test.cjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "5.2.5",
    "@hookform/resolvers": "3.10.0",
    "@remotion/bundler": "4.0.525",
    "@remotion/player": "4.0.525",
    "@remotion/renderer": "4.0.525",
    "@tanstack/react-query": "5.66.8",
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "7.54.2",
    "remotion": "4.0.525",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/node": "22.13.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "jsdom": "26.0.0",
    "prettier": "3.6.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.0",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
