# Database. Use postgresql+psycopg://user:password@host:5432/paper for PostgreSQL.
API_PORT=8000
DATABASE_URL=sqlite:///storage/studio.db
# Optional Docker-only database URL; keeps host file paths out of the container.
DOCKER_DATABASE_URL=sqlite:////app/storage/studio.db
# Absolute directory recommended. Relative storage path is resolved from repository root.
STORAGE_DIR=storage
# Exact browser origins, comma-separated. No wildcard in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080
# demo or anthropic. A missing key uses deterministic demo analysis.
AI_PROVIDER=demo
AI_MODEL=claude-sonnet-4-20250514
AI_API_KEY=
AI_BASE_URL=https://api.anthropic.com
AI_TIMEOUT=90
# Optional direct ElevenLabs connection (takes priority over Runway for narration).
TTS_API_KEY=
TTS_VOICE_ID=
TTS_MODEL=eleven_multilingual_v2
# Runway image-to-video and caption narration. Requires developer API credits.
RUNWAY_API_KEY=
VIDEO_TIMEOUT=900
# Storage quota and upload limits in MiB. Image decompression limit in pixels.
STORAGE_LIMIT_MB=10240
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=40000000
# Seconds per rendering subprocess; Chrome frame concurrency.
RENDER_TIMEOUT=1800
RENDER_CONCURRENCY=2
# Blank: detect installed Chrome/Chromium, or Remotion downloads its browser on first use.
BROWSER_EXECUTABLE=
# Blank: system PATH first, then npm-installed static binaries.
FFMPEG_PATH=
FFPROBE_PATH=
